{
  "url": "https://github.com/search?q=author%3A%40me&type=commits&s=author-date&o=desc",
  "method": "GET",
  "credentials": "include",
  "responseMatches": [
    {
      "type": "contains",
      "value": "title=\"{{commit_message}}"
    },
    {
      "type": "contains",
      "value": "\"author_date\":\"{{commit_date}}\""
    }
  ],
  "responseRedactions": [
    {
      "xPath": "(//div[@data-testid=\"results-list\"]//h3//a[contains(@href,\"/commit/\")])[1]/parent::*",
      "regex": "title=\"(?<commit_message>[^\"<>\\n]+)"
    },
    {
      "xPath": "//script[@data-target=\"react-app.embeddedData\"]",
      "regex": "\"author_date\":\"(?<commit_date>[^\"<>\\n]+)\""
    }
  ]
}
